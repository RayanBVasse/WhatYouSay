<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>WhatYouSay-LevelA-Render</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/static/css/main.css">
  <link rel="stylesheet" href="/static/css/forms.css">

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    .levela-intro-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-bottom: 0.75rem;
    }
    .intro-panel {
      background: #f7fafc;
      border: 1px solid #d8e3eb;
      border-radius: 10px;
      padding: 0.9rem 1rem;
    }
    .visual-quad-section {
      margin-top: 0.55rem;
    }
    .quad-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
    .quad-card {
      border: 1px solid #d8e3eb;
      border-radius: 10px;
      background: #f8fbfd;
      padding: 0.85rem;
      min-height: 100%;
    }
    .quad-card h3 {
      margin-bottom: 0.45rem;
    }
    .quad-card img {
      width: 100%;
      height: 265px;
      object-fit: contain;
      border: 1px solid #dbe7ef;
      border-radius: 8px;
      background: #ffffff;
      display: block;
    }
    .chart-caption {
      margin-top: 0.65rem;
      line-height: 1.45;
      font-size: 0.98rem;
      color: #44565f;
    }
    .preview-card {
      background: #f3f8fb;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .preview-copy {
      line-height: 1.55;
      color: #3d4e57;
      margin-bottom: 0.65rem;
    }
    .preview-copy strong {
      color: #22353f;
    }
    .preview-points {
      margin: 0.45rem 0 0.9rem 1rem;
      color: #445760;
    }
    .preview-points li {
      margin-bottom: 0.25rem;
      line-height: 1.45;
    }
    .preview-actions {
      margin-top: 0.35rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      align-items: center;
    }
    .preview-actions form {
      margin: 0;
    }
    .preview-or {
      margin: 0.2rem 0 0.35rem;
      font-weight: 700;
      color: #4a5e67;
      letter-spacing: 0.02em;
    }
    @media (max-width: 980px) {
      .levela-intro-grid,
      .quad-grid {
        grid-template-columns: 1fr;
      }
      .quad-card img {
        height: 235px;
      }
    }
  </style>
</head>

<body>
<div id="page-wrapper">
  <!-- Header -->
				<div id="header-wrapper">
					<div class="container">
						<div class="row">
							<div class="col-12">

								<header id="header">
									<h1><a href="{{ url_for('index') }}" id="logo">WhatYouSay</a></h1>
									<nav id="nav">
										<a href="{{ url_for('index') }}">Homepage</a>
                                        <a href="{{ url_for('method_page') }}">Method</a>
                                        <a href="{{ url_for('publication_page') }}">Publication</a>
                                        <a href="{{ url_for('privacy_page') }}">Privacy</a>
                                        <a href="#">HowWeConnect</a>

									</nav>
								</header>

							</div>
						</div>
					</div>
				</div>

<!-- Main -->
<div id="main">
<div class="container">
	<div class="row main-row">
		<div class="col-12">
			<section>
				<h2>Your participation!</h2>
				<ul class="metrics-list">
				<li><b>Total messages analysed&nbsp;&nbsp;:&nbsp;&nbsp; <b>{{ metrics.n_messages }}</b></li></b>
				<li>
					<b>Analysis reliability&nbsp;&nbsp;:&nbsp;&nbsp;<b>{{ metrics.confidence }}</b></b> 
					<div class="hint">
					(Based on the amount of text available for this analysis.)
					</div>
				</li>
				</ul>
			</section>

		</div>
		<div class="col-12">

			<section class="levela-intro-grid">
				<article class="intro-panel">
					<h2>What this means (plain language)</h2>
					<ul class="metrics-list">
					<li>
						<h3>Average message length:</h3> <b>Words&nbsp;&nbsp;:</b>  {{ metrics.avg_len_words }}
						<span class="hint">&nbsp;&nbsp;(How much you tend to say per message)</span>
					</li>
					<li>
						<b>Questions&nbsp;&nbsp;:</b> {{ metrics.question_pct }}%
						<span class="hint">&nbsp;&nbsp;(Signals curiosity and engagement)</span>
					</li>
					<li>
						<b>Emoji use&nbsp;&nbsp;:</b> {{ metrics.emoji_pct }}%
						<span class="hint">&nbsp;&nbsp;(Light emotional or tone signalling)</span>
					</li>
					<li>
						<b>Overall tone balance&nbsp;&nbsp;:</b> {{ metrics.tone_valence }}
						<span class="hint">&nbsp;&nbsp;(A neutral-to-positive balance is common)</span>
					</li>
					</ul>
				</article>

				<article class="intro-panel">
					<h2>Visual summaries</h2>
					<p class="caption">
						The charts below offer a visual snapshot of how your communication unfolds over time.
						They are not meant to diagnose or judge. Think of this as a compact observation layer:
						the same words you already wrote, viewed from a different angle. You do not need to
						interpret every value. What matters most is the overall shape, balance, and rhythm.
					</p>
				</article>
			</section>
		</div>
			
		{% if metrics["files"] is defined %}
    <div class="col-12">
<section class="visual-section">

  {# ---------- ROW 1: Emotion + Moral ---------- #}
  <div class="visual-row two-col">

		    {% if metrics["files"]["emotion_distribution"] is defined and metrics["files"]["emotion_distribution"] %}
		
		    <div class="visual-block">
		      <h3>Emotion distribution</h3>
		      <img
		        src="{{ url_for('serve_results', safe_user=safe_user, filename=metrics['files']['emotion_distribution']) }}"
		        alt="Emotion distribution chart"
		      >
		      <p class="caption">
		        This chart shows how emotional signals are distributed across your messages.
		      </p>
		    </div>
		
		    {% endif %}

		    {% if metrics["files"]["moral_loading"] is defined and metrics["files"]["moral_loading"] %}
		
		    <div class="visual-block">
		      <h3>Moral / value framing</h3>
		      <img
		        src="{{ url_for('serve_results', safe_user=safe_user, filename=metrics['files']['moral_loading']) }}"
		        alt="Moral loading chart"
		      >
		      <p class="caption">
		        This view captures how often your language reflects values or evaluative judgement.
		      </p>
		    </div>
		
		    {% endif %}

  </div>

		  {# ---------- ROW 2: Valence timeline ---------- #}
		  {% if metrics["files"]["valence_timeline"] is defined and metrics["files"]["valence_timeline"] %}
		
		  <div class="visual-row full-width">
		    <div class="visual-block">
		      <h3>Emoji valence timeline</h3>
		      <img
		        src="{{ url_for('serve_results', safe_user=safe_user, filename=metrics['files']['valence_timeline']) }}"
		        alt="Valence timeline chart"
		      >
		      <p class="caption">
		        This timeline tracks emotional signalling through emojis over time.
		      </p>
		    </div>
		  </div>
		
		  {% endif %}

</section>
    </div>
{% endif %}


	<div class="col-6 col-12-medium">
        <article class="blog-post">
        <h2>Level B preview</h2>
			
  <!--  <a href="#"><img src="{{ url_for('static', filename='preview/LevelB_glimpse2.png') }}" alt="Level B preview" class="levelb-preview-img"></a> -->
        
			<h3>How you come across.... is even more important!</h3>
		
			<p>So far in Level-A analysis 
		<br><strong><i>Your emotional signature:&nbsp;&nbsp;</i></strong>“Across hundreds of messages, 
			your emotional tone tends to settle into a stable range. This doesn’t describe mood — it describes style. 
			Some people communicate with sharp peaks; others with steady presence. You’re closer to the latter.”
		<br><strong><i>Where pressure shows up: &nbsp;&nbsp;</i></strong>	“Your language becomes more value-driven around specific 
		topics. This is where conviction, disagreement, or leadership tends to emerge — often without conscious intent.”	
		<br><strong><i>Your role in group dynamics: &nbsp;&nbsp;</i></strong>	“In group conversations, you tend to occupy a 
		stabilizing role — contributing steadily rather than dominating or withdrawing.”
		<br><br><strong> Level B places your emotional tone, pressure points, and narrative role into a broader conversational context.</strong></p>
              
			<footer class="controls">
				<form action="{{ url_for('delete_and_exit') }}" method="post">
				<button class="button" type="submit">Exit</button>
				</form>
				<br><h3>OR</h3>
				{% if paywall_enabled %}
					{% if not paid %}
					<a href="{{ url_for('pay') }}" class="button">Pay with PayPal</a>
					<button disabled style="opacity:0.5;">Welcome to Level B</button>
					{% else %}
					<button disabled style="opacity:0.5;">Payment confirmed</button>
					<a href="{{ url_for('level_b_intro') }}" class="button">Welcome to Level B</a>
					{% endif %}
				{% else %}
				<button disabled style="opacity:0.5;">PayPal disabled for now</button>
				<a href="{{ url_for('level_b_intro') }}" class="button">Continue to Level B</a>
				{% endif %}
				<hr>
			</footer>
                        </article>
                        </div>
					</div>
				</div>
				</div>
</div>

  
  
			<!-- Footer -->
				<div id="footer-wrapper">
					<div class="container">
						<div class="row">
							<div class="col-8 col-12-medium">

								<section>
									<h2>How about a truckload of links?</h2>
									<div>
										<div class="row">
											<div class="col-3 col-6-medium col-12-small">
												<ul class="link-list">
													<li><a href="#">Sed neque nisi consequat</a></li>
													<li><a href="#">Dapibus sed mattis blandit</a></li>
													<li><a href="#">Quis accumsan lorem</a></li>
													<li><a href="#">Suspendisse varius ipsum</a></li>
													<li><a href="#">Eget et amet consequat</a></li>
												</ul>
											</div>
											<div class="col-3 col-6-medium col-12-small">
												<ul class="link-list">
													<li><a href="#">Quis accumsan lorem</a></li>
													<li><a href="#">Sed neque nisi consequat</a></li>
													<li><a href="#">Eget et amet consequat</a></li>
													<li><a href="#">Dapibus sed mattis blandit</a></li>
													<li><a href="#">Vitae magna sed dolore</a></li>
												</ul>
											</div>
											<div class="col-3 col-6-medium col-12-small">
												<ul class="link-list">
													<li><a href="#">Sed neque nisi consequat</a></li>
													<li><a href="#">Dapibus sed mattis blandit</a></li>
													<li><a href="#">Quis accumsan lorem</a></li>
													<li><a href="#">Suspendisse varius ipsum</a></li>
													<li><a href="#">Eget et amet consequat</a></li>
												</ul>
											</div>
											<div class="col-3 col-6-medium col-12-small">
												<ul class="link-list">
													<li><a href="#">Quis accumsan lorem</a></li>
													<li><a href="#">Sed neque nisi consequat</a></li>
													<li><a href="#">Eget et amet consequat</a></li>
													<li><a href="#">Dapibus sed mattis blandit</a></li>
													<li><a href="#">Vitae magna sed dolore</a></li>
												</ul>
											</div>
										</div>
									</div>
								</section>

							</div>
							<div class="col-4 col-12-medium">

								<section>
									<h2>Something of interest</h2>
									<p>Duis neque nisi, dapibus sed mattis quis, rutrum accumsan sed.
									Suspendisse eu varius nibh. Suspendisse vitae magna eget odio amet
									mollis justo facilisis quis. Sed sagittis mauris amet tellus gravida
									lorem ipsum dolor sit blandit.</p>
									<footer class="controls">
										<a href="#" class="button">Oh, please continue ....</a>
									</footer>
								</section>

							</div>
						</div>
						<div class="row">
							<div class="col-12">

								<div id="copyright">
									&copy; Untitled. All rights reserved. | Design: <a href="http://html5up.net">HTML5 UP</a>
								</div>

							</div>
						</div>
					</div>
				</div>



<!-- Scripts -->
			<script src="/static/js/jquery.min.js"></script>
            <script src="/static/js/browser.min.js"></script>
            <script src="/static/js/breakpoints.min.js"></script>
            <script src="/static/js/util.js"></script>
            <script src="{{ url_for('static', filename='js//main.js') }}"></script>
</body>
</html>

























